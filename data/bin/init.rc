termux-change-repo
# 定义路径，移除空格

# 全局状态
STEP=0
FAILED=0

cleanup() {
    local exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo ""
        echo "⚠脚本异常退出（退出码 $exit_code）"
    fi
    # 恢复终端设置
    stty sane 2>/dev/null || true
}

trap cleanup EXIT INT TERM

# 检测是否为 Termux 环境
is_termux() {
    # 方法1：检查 Termux 特有的环境变量
    [ -n "$TERMUX_VERSION" ] && return 0

    # 方法2：检查 Termux 专属的目录结构
    [ -d /data/data/com.termux/files/usr ] && return 0

    # 方法3：检查 PREFIX 环境变量（Termux 的标准路径）
    [ "$PREFIX" = "/data/data/com.termux/files/usr" ] && return 0

    # 方法4：检查是否存在 termux-info 命令
    command -v termux-info >/dev/null 2>&1 && return 0

    return 1
}

# 检测网络连接（基于 ICMP）
# 参数: 可指定测试目标（默认 8.8.8.8）
# 返回: 0 表示网络可达，1 表示不可达
check_network_ping() {
    target="${1:-8.8.8.8}"          # 默认 Google DNS
    timeout="${2:-3}"               # 超时秒数

    # -c 1 只发一个包，-W 设置超时
    if ping -c 1 -W "$timeout" "$target" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

if is_termux; then
    echo "当前环境是 Termux。"
else
    echo "当前环境不是 Termux。"
    exit 1
fi

if check_network_ping; then
    echo "网络已连接"
else
    echo "网络未连接" >&2
    exit 1
fi

source "$HOME/storage/shared/MITS/data/General_architecture_shell/must_run"
source "$HOME/storage/shared/MITS/data/General_architecture_shell/safe_run"
source "$HOME/storage/shared/MITS/data/General_architecture_shell/log_step"
source "$HOME/storage/shared/MITS/data/General_architecture_shell/error_exit"
source "$HOME/storage/shared/MITS/data/General_architecture_shell/Color"
source "$HOME/storage/shared/MITS/data/General_architecture_shell/git_version"

cd "$HOME/storage/shared/MITS"

if ! update_mits_version; then
    echo "无法更新配置文件"
    echo "已使用0.16版本之前的版本号方式"
else
    echo "更新配置文件已完成"
fi

bin="/data/data/com.termux/files/usr/bin"
init="$HOME/storage/shared/MITS/data/bin"

log_step "批量复制 .sh 脚本文件"

# 检查 init 目录是否存在
if [ ! -d "${init}" ]; then
    echo "错误：源目录 ${init} 不存在"
    exit 1
fi

# 批量获取 init 目录下所有 .sh 脚本文件
sh_files=("${init}"/*.sh)

# 检查是否有 .sh 文件 */
if [ ! -f "${sh_files[0]}" ]; then
    echo "错误：${init} 目录下没有找到 .sh 脚本文件"
    exit 1
fi

# 批量复制并赋予执行权限
for file in "${sh_files[@]}"; do
    # 获取文件名（不含路径）
    filename=$(basename "${file}")
    # 复制到目标目录
    cp "${file}" "${bin}/${filename}"
    # 赋予执行权限
    chmod +x "${bin}/${filename}"
    echo "已处理：${filename}"
done

echo -e "\n所有 .sh 脚本文件复制完成，已赋予执行权限！"

log_step "批量复制 .py 脚本文件"

echo "目标目录：${bin}"

py_files=("${init}"/*.py)

# */

log_step "设置 Termux 属性"
echo "phantom-process = true" >> ~/.termux/termux.properties
echo "已添加 phantom-process = true"

if [ ! -f "${py_files[0]}" ]; then
    echo "错误：${init} 目录下没有找到 .py 脚本文件"
    exit 1
fi

# 批量复制并赋予执行权限
for file in "${py_files[@]}"; do
    # 获取文件名（不含路径）
    filename=$(basename "${file}")
    # 复制到目标目录
    cp "${file}" "${bin}/${filename}"
    # 赋予执行权限
    chmod +x "${bin}/${filename}"
    echo "已处理：${filename}"
done

echo -e "\n所有 .py 脚本文件复制完成，已赋予执行权限！"
echo "目标目录：${bin}"

#开始运行

echo "开始运行整体安装流程......"

INIT_SCRIPT="${bin}/temp.data.init.sh"
if [ -f "$INIT_SCRIPT" ]; then
    must_run "执行 temp.data.init.sh" bash "$INIT_SCRIPT"
else
    error_exit "未找到 temp.data.init.sh（在 ${bin} 中）"
fi

log_step "清理安装脚本"

if [ -f "${bin}/init.rc" ]; then
    rm -f "${bin}/init.rc"
    echo "✓ 已删除 ${bin}/init.rc"
else
    echo "  （init.rc 不存在，跳过）"
fi

log_step "修复 zsh 目录权限"

if command -v compaudit >/dev/null 2>&1; then
    compaudit 2>/dev/null | while IFS= read -r dir; do
        [ -n "$dir" ] && chmod g-w,o-w "$dir" 2>/dev/null
    done
    echo "✓ compaudit 权限修复完成"
else
    echo "  （compaudit 不可用，跳过）"
fi

for dir in ~/.zinit ~/.zinit/plugins ~/.cache; do
    if [ -d "$dir" ]; then
        chmod 755 "$dir"
        echo "  ✓ 已设置权限：$dir"
    else
        echo "  （目录不存在，跳过：$dir）"
    fi
done

# 或者直接运行

if [ -d ~/.zinit ]; then
    chmod 755 ~/.zinit
fi

chmod 755 ~/.zinit/plugins
chmod 755 ~/.cache

# 清理 zcompdump 文件
rm -f ~/.zcompdump*
# 更新包管理器
log_step "更新包管理器"
must_run "pkg update" pkg update
must_run "pkg upgrade" pkg upgrade -y
# 手动安装缺失的插件
log_step "安装必要依赖"
must_run "安装 zsh 和 git" pkg install -y zsh git

# 安装常用插件

echo "安装插件中......"

PLUGINS=(
    "https://github.com/zsh-users/zsh-autosuggestions|$HOME/.zinit/plugins/_local---zsh-autosuggestions"
    "https://github.com/zdharma-continuum/fast-syntax-highlighting|$HOME/.zinit/plugins/_local---fast-syntax-highlighting"
    "https://github.com/ohmyzsh/ohmyzsh.git|$HOME/.oh-my-zsh"
)

for plugin in "${PLUGINS[@]}"; do
    url="${plugin%%|*}"
    dest="${plugin##*|}"
    
    if [ -d "$dest/.git" ]; then
        echo "  （已存在，跳过：$dest）"
        continue
    fi
    
    # 确保父目录存在
    mkdir -p "$(dirname "$dest")"
    if safe_run "克隆 $url" git clone --depth 1 "$url" "$dest"; then
        echo "安装成功：$dest"
    else
        echo " 安装失败：$dest"
    fi
done

log_step "复制 oh-my-zsh 插件"

OMZ_DIR="$HOME/.oh-my-zsh"
ZINIT_PLUGINS="$HOME/.zinit/plugins"

if [ ! -d "$OMZ_DIR/plugins" ]; then
    echo "警告：oh-my-zsh 插件目录不存在，跳过复制"
else
    OMZ_PLUGINS=(
        "extract"
        "z"
        "git"
        "sudo"
        "colored-man-pages"
        "command-not-found"
    )
    
    for plugin in "${OMZ_PLUGINS[@]}"; do
        src="$OMZ_DIR/plugins/$plugin"
        dest="$ZINIT_PLUGINS/_local---$plugin"
        if [ -d "$src" ]; then
            if cp -r "$src" "$dest" 2>/dev/null; then
                echo "  ✓ 已复制：$plugin"
            else
                echo "  ⚠ 复制失败：$plugin"
                FAILED=$((FAILED + 1))
            fi
        else
            echo "  （源不存在，跳过：$plugin）"
        fi
    done
fi

log_step "安装完成"
if [ $FAILED -gt 0 ]; then
    echo ""
    echo "有 ${FAILED} 个非致命警告/失败，请查看上方日志"
    exit 1
else
    echo ""
    echo "所有操作成功完成！"
    exit 0
fi